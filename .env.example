# Production environment variables — copy to .env and fill in

# Docker image registry (GitHub Container Registry)
# Format: ghcr.io/<your-github-username>
IMAGE_REGISTRY=ghcr.io/your-username/belgisiz-nomur
TAG=latest

# Domain
DOMAIN=bn.osmonov.com
ADMIN_EMAIL=you@example.com

# Public URLs (NEXT_PUBLIC_API_URL is baked into the web image at build time via CI)
NEXT_PUBLIC_API_URL=https://api.bn.osmonov.com
SITE_URL=https://bn.osmonov.com

# Telegram bot
TELEGRAM_BOT_TOKEN=your_token_here
BOT_WEBHOOK_URL=https://bn.osmonov.com/bot
